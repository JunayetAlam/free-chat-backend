{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "prisma": {
    "schema": "./prisma"
  },
  "scripts": {
    "start:prod": "NODE_ENV=production bun ./dist/server.js",
    "start:dev": "NODE_ENV=development bun --watch src/server.ts",
    "check:types": "tsc --noEmit",
    "build": "tsc",
    "prod:build": "bun install && bunx --bun prisma migrate dev && bunx --bun prisma generate && bun run build && pm2 restart 14",
    "gm": "ts-node gn-module.ts",
    "pgen:studio": "node -r ./scripts/prisma-env.cjs node_modules/prisma/build/index.js generate && node -r ./scripts/prisma-env.cjs node_modules/prisma/build/index.js studio --port 7548",
    "pm": "node -r ./scripts/prisma-env.cjs node_modules/prisma/build/index.js migrate dev",
    "pgen": "bunx --bun prisma generate",
    "pm:pgen": "bun run pm && bun run pgen",
    "pm:co": "node -r ./scripts/prisma-env.cjs node_modules/prisma/build/index.js migrate dev --create-only",
    "pm:deploy": "bunx --bun prisma migrate deploy",
    "studio": "node -r ./scripts/prisma-env.cjs node_modules/prisma/build/index.js studio --port 7548",
    "postinstall": "bunx --bun prisma generate",
    "dbpush": "node -r ./scripts/prisma-env.cjs node_modules/prisma/build/index.js db push",
    "pm:reset": "node -r ./scripts/prisma-env.cjs node_modules/prisma/build/index.js migrate reset"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/express-rate-limit": "^6.0.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.1",
    "prettier": "^3.8.1",
    "prisma": "^6.10.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.936.0",
    "@aws-sdk/lib-storage": "^3.936.0",
    "@prisma/client": "^6.10.1",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.9.0",
    "cookie": "^1.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.1",
    "firebase-admin": "^14.2.0",
    "http-status": "^1.8.1",
    "jsonwebtoken": "^9.0.2",
    "minio": "^8.0.6",
    "multer": "^2.1.0",
    "nanoid": "^3.3.11",
    "nodemailer": "^8.0.1",
    "pg": "^8.22.0",
    "ts-node-dev": "^2.0.0",
    "ws": "^8.18.3",
    "zod": "^4.3.6"
  }
}
