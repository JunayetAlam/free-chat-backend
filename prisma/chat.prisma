model Room {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  name              String?
  inviteCode        String    @unique
  creatorGuestId    String
  creatorIp         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  isDeleted         Boolean   @default(false)
  isArchived        Boolean   @default(false)
  deletedAt         DateTime?
  archivedAt        DateTime?
  deletedByGuestId  String?
  archivedByGuestId String?

  creator  Guest         @relation("RoomCreator", fields: [creatorGuestId], references: [id])
  members  RoomMember[]
  messages Message[]
  logs     ActivityLog[]

  @@index([creatorGuestId])
  @@index([isDeleted, isArchived])
  @@map("rooms")
}

model RoomMember {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  roomId      String    @db.ObjectId
  guestId     String
  displayName String
  joinIp      String?
  lastIp      String?
  userAgent   String?
  lastReadAt  DateTime?
  joinedAt    DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  leftAt      DateTime?

  isDeleted  Boolean   @default(false)
  isArchived Boolean   @default(false)
  deletedAt  DateTime?
  archivedAt DateTime?

  room  Room  @relation(fields: [roomId], references: [id])
  guest Guest @relation(fields: [guestId], references: [id])

  @@unique([roomId, guestId])
  @@index([guestId])
  @@map("room_members")
}

model Message {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  roomId            String    @db.ObjectId
  senderGuestId     String
  senderDisplayName String
  senderIp          String?
  content           String
  previousContent   String?
  isEdited          Boolean   @default(false)
  editedAt          DateTime?
  editedIp          String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  isDeleted         Boolean   @default(false)
  isArchived        Boolean   @default(false)
  deletedAt         DateTime?
  archivedAt        DateTime?
  deletedByGuestId  String?
  deletedIp         String?
  archivedByGuestId String?

  room   Room  @relation(fields: [roomId], references: [id])
  sender Guest @relation(fields: [senderGuestId], references: [id])

  @@index([roomId, createdAt])
  @@index([senderGuestId])
  @@index([roomId, isDeleted, isArchived])
  @@map("messages")
}
