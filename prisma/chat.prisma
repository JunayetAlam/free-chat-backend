model Room {
  id                String    @id @default(uuid())
  name              String?
  image             String?
  inviteCode        String    @unique
  creatorGuestId    String
  creatorIp         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Daily edit quotas (Asia/Dhaka calendar day in *ChangeDay)
  nameChangeCount   Int       @default(0)
  nameChangeDay     String?
  imageChangeCount  Int       @default(0)
  imageChangeDay    String?

  isDeleted         Boolean   @default(false)
  isArchived        Boolean   @default(false)
  deletedAt         DateTime?
  archivedAt        DateTime?
  deletedByGuestId  String?
  archivedByGuestId String?

  creator  Guest         @relation("RoomCreator", fields: [creatorGuestId], references: [id])
  members  RoomMember[]
  joinedBy JoinedRoom[]
  messages Message[]
  logs     ActivityLog[]

  @@index([creatorGuestId])
  @@index([isDeleted, isArchived])
  @@map("rooms")
}

model RoomMember {
  id          String    @id @default(uuid())
  roomId      String
  guestId     String
  displayName String
  joinIp      String?
  lastIp      String?
  userAgent   String?
  lastReadAt  DateTime?
  joinedAt    DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  leftAt      DateTime?

  isDeleted  Boolean   @default(false)
  isArchived Boolean   @default(false)
  deletedAt  DateTime?
  archivedAt DateTime?

  room  Room  @relation(fields: [roomId], references: [id])
  guest Guest @relation(fields: [guestId], references: [id])

  @@unique([roomId, guestId])
  @@index([guestId])
  @@map("room_members")
}

/** Per-guest room history: created once on first join; soft-deletable from history */
model JoinedRoom {
  id            String    @id @default(uuid())
  roomId        String
  guestId       String
  firstJoinedAt DateTime  @default(now())
  lastJoinedAt  DateTime  @default(now())
  joinIp        String?
  userAgent     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  isDeleted  Boolean   @default(false)
  isArchived Boolean   @default(false)
  deletedAt  DateTime?
  archivedAt DateTime?

  room  Room  @relation(fields: [roomId], references: [id])
  guest Guest @relation(fields: [guestId], references: [id])

  @@unique([roomId, guestId])
  @@index([guestId, isDeleted])
  @@index([roomId])
  @@map("joined_rooms")
}

model Message {
  id                String    @id @default(uuid())
  roomId            String
  senderGuestId     String
  senderDisplayName String
  senderIp          String?
  content           String
  previousContent   String?
  isEdited          Boolean   @default(false)
  editedAt          DateTime?
  editedIp          String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  isDeleted         Boolean   @default(false)
  isArchived        Boolean   @default(false)
  deletedAt         DateTime?
  archivedAt        DateTime?
  deletedByGuestId  String?
  deletedIp         String?
  archivedByGuestId String?

  room   Room  @relation(fields: [roomId], references: [id])
  sender Guest @relation(fields: [senderGuestId], references: [id])

  @@index([roomId, createdAt])
  @@index([senderGuestId])
  @@index([roomId, isDeleted, isArchived])
  @@map("messages")
}
