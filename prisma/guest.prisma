model Guest {
  id           String    @id // client UUID string
  displayName  String?
  profilePhoto String?
  lastIp       String?
  createdIp    String?
  userAgent    String?
  deviceLabel  String?
  notificationsEnabled Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastSeenAt   DateTime  @default(now())

  // Daily edit quotas (Asia/Dhaka calendar day in *ChangeDay)
  profileNameChangeCount  Int     @default(0)
  profileNameChangeDay    String?
  profileImageChangeCount Int     @default(0)
  profileImageChangeDay   String?

  isDeleted  Boolean   @default(false)
  isArchived Boolean   @default(false)
  deletedAt  DateTime?
  archivedAt DateTime?

  createdRooms Room[]          @relation("RoomCreator")
  memberships  RoomMember[]
  joinedRooms  JoinedRoom[]
  messages     Message[]
  activityLogs ActivityLog[]
  fcmTokens    GuestFcmToken[]

  @@map("guests")
}

model GuestFcmToken {
  id        String   @id @default(uuid())
  guestId   String
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([guestId])
  @@map("guest_fcm_tokens")
}
