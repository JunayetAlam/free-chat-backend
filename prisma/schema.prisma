generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum ActivityAction {
  ROOM_CREATE
  ROOM_JOIN
  ROOM_LEAVE
  ROOM_ARCHIVE
  ROOM_DELETE
  ROOM_UPDATE
  MESSAGE_CREATE
  MESSAGE_EDIT
  MESSAGE_DELETE
  MESSAGE_ARCHIVE
  MESSAGE_HISTORY_READ
  MEMBER_UPDATE
  MEMBER_LEAVE
}
