# =============================================================================
# Env layout (loaded by src/config/index.ts)
# =============================================================================
# .env                 → common vars (always loaded) — copy from this file
# .env.development     → used by `bun start:dev`  — copy from .env.development.example
# .env.production      → used by `bun start:prod` — copy from .env.production.example
#
# Mode files override any overlapping keys from .env.
# =============================================================================

# --- Common (.env) ---
PROJECT_NAME=FlexiChat
PORT=5467

MAIL=
MAIL_PASS=

MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=587
MAILTRAP_USER=
MAILTRAP_PASSWORD=

# Docker Redis (no password in compose)
REDIS_HOST=127.0.0.1
REDIS_PORT=8596
REDIS_PASSWORD=

DO_SPACE_ENDPOINT=
DO_SPACE_ACCESS_KEY=
DO_SPACE_SECRET_KEY=
DO_SPACE_BUCKET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_SECRET=
CLOUDINARY_API_KEY=
CLOUDINARY_PROJECT_NAME=

MI_SPACE_ENDPOINT=
MI_SPACE_ACCESS_KEY=
MI_SPACE_SECRET_KEY=
MI_SPACE_BUCKET=
MI_USE_SSL=
MI_PORT=

# --- Mode-specific ---
# See .env.development.example / .env.production.example
