# Mode-specific env for `bun start:dev` (NODE_ENV=development).
# Copy to .env.development:  cp .env.development.example .env.development
# Loaded after .env and overrides overlapping keys (see src/config/index.ts).

NODE_ENV=development

# Docker Postgres (docker compose --profile local)
# Password FC@2026 → URL-encoded as FC%402026
DATABASE_URL="postgresql://postgres:FC%402026@localhost:8594/fc_production?schema=public"

SUPER_ADMIN_PASSWORD=123456
BCRYPT_SALT_ROUNDS=12

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

BASE_URL_CLIENT="http://localhost:4467"
BASE_URL_SERVER="http://localhost:5467"
