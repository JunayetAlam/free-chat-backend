# Mode-specific env for `bun start:prod` (NODE_ENV=production).
# Copy to .env.production:  cp .env.production.example .env.production
# Loaded after .env and overrides overlapping keys (see src/config/index.ts).

NODE_ENV=production

# Replace with your production Postgres connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

SUPER_ADMIN_PASSWORD=
BCRYPT_SALT_ROUNDS=12

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

BASE_URL_CLIENT="https://flexi-chat.junayetalam.me"
BASE_URL_SERVER="https://api-flexi-chat.junayetalam.me"
